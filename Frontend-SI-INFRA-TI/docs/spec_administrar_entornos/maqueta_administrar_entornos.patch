+  { nombre: "Data Center Callao DR", latitud: "-12.0566", longitud: "-77.1181", clusters: 1, equipos: 6 },
+  { nombre: "Data Center Trujillo Norte", latitud: "-8.1116", longitud: "-79.0288", clusters: 1, equipos: 5 },
+  { nombre: "Data Center Arequipa Sur", latitud: "-16.4090", longitud: "-71.5375", clusters: 1, equipos: 7 },
+  { nombre: "Data Center Piura", latitud: "-5.1945", longitud: "-80.6328", clusters: 0, equipos: 0 },
+];
+const VACIO = { nombre: "", latitud: "", longitud: "" };
+const enRango = (v, max) => v.trim() === "" || (!Number.isNaN(Number(v)) && Math.abs(Number(v)) <= max);
+
+function AdministrarDatacenters() {
+  const [query, setQuery] = useState("");
